DEBUG=true
# Genere una clave para producción: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Solo con DEBUG=true, omitir DATABASE_URL usa SQLite local.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/nexo
# Vercel: DEBUG=false; TRUST_PROXY=true; SECRET_KEY y DATABASE_URL obligatorias.
# ALLOWED_HOSTS=contabilidad-fresas.vercel.app
# CSRF_TRUSTED_ORIGINS=https://contabilidad-fresas.vercel.app
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
TRUST_PROXY=false

# Sincronización (un único computador local por negocio en esta versión).
# Nube: OFFLINE_NODE=false; SYNC_USER=usuario técnico activo con permisos.
# Local: OFFLINE_NODE=true; DATABASE_URL=sqlite:////ruta/absoluta/fresas-local.sqlite3
# Local y nube comparten SYNC_TOKEN y SYNC_BUSINESS. Nunca los publique en Git.
OFFLINE_NODE=false
SYNC_URL=
SYNC_TOKEN=
SYNC_USER=
SYNC_BUSINESS=
SYNC_INTERVAL=120

# Comprobantes y números locales de clientes (Colombia: 57).
BUSINESS_NAME=Mi Contabilidad
WHATSAPP_COUNTRY_CODE=57
